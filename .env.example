# Copy to .env and fill in real values. NEVER commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Supabase ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Public anon key (safe for client-side, RLS-gated)
SUPABASE_ANON_KEY=
# Service-role key (server-only, bypasses RLS — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name for uploaded workout videos
SUPABASE_VIDEO_BUCKET=workout-videos

# --- Computer Vision ---
# Max video length accepted for analysis (seconds)
MAX_VIDEO_SECONDS=120
# Frames per second to sample for pose estimation
ANALYSIS_SAMPLE_FPS=10

# --- Job queue / worker (Cloud Run + worker pattern) ---
# Redis connection used by the analysis job queue (e.g. Upstash). Worker + API share it.
REDIS_URL=
# Optional: bound concurrent analysis jobs per worker instance
WORKER_CONCURRENCY=2

# --- Hosting (Cloud Run) ---
# Cloud Run injects PORT at runtime; default for local dev only.
PORT=8080
